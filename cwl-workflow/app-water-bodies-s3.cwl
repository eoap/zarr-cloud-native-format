  - class: InitialWorkDirRequirement
    listing:
    - entryname: run.sh
      entry: '#!/usr/bin/env sh

        set -x

        set -euo pipefail


        yq ''[.features[].links[] | select(.rel=="self") | .href]'' "$(inputs.search_results.path)"
        > items.json


        echo "$(inputs.search_request)" | yq ''.bbox | @csv'' - > aoi.txt'
