  - id: consolidate
    label: Consolidate metadata
    doc: Write consolidated Zarr metadata after generation
    default: true
    type: boolean
    inputBinding:
      prefix: --consolidate
  - id: titiler_eopf_compatible
    label: TiTiler-EOPF compatibility
    doc: Deprecated compatibility flag; GeoZarr convention v0.1 root metadata is always
      emitted
    default: false
    type: boolean
    inputBinding:
      prefix: --titiler-eopf-compatible
  - id: stac_object_type
    label: STAC object type
    doc: Output STAC object type to emit (collection or item)
    default: collection
    type:
      name: _:c5a5f8e7-136c-4544-9b05-68c2108aa006
      symbols:
      - file:///data/work/github-com/eoap/zarr-cloud-native-format/cwl-workflow/app-water-bodies.cwl#stac-zarr/stac_object_type/collection
      - file:///data/work/github-com/eoap/zarr-cloud-native-format/cwl-workflow/app-water-bodies.cwl#stac-zarr/stac_object_type/item
      type: enum
    inputBinding:
      prefix: --stac-object-type
  outputs:
  - id: zarr_stac_catalog
    label: Zarr STAC catalog
    doc: STAC catalog output containing Zarr store metadata
    type: Directory
    outputBinding:
      glob: .
  requirements:
  - class: InlineJavascriptRequirement
  - class: ResourceRequirement
    coresMax: 1
    ramMin: 2048
    ramMax: 2048
  - class: DockerRequirement
    dockerPull: stac-zarr:latest
  cwlVersion: v1.2
  baseCommand:
  - stac-zarr
  arguments: []
- id: crop
  class: CommandLineTool
  inputs:
  - id: item
    label: Input STAC item href
    doc: STAC item href to crop
    type: string
    inputBinding:
      prefix: --input-item
  - id: aoi
    label: Area of interest
    doc: Area of interest bbox as CSV
    type: string
    inputBinding:
      prefix: --aoi
  - id: epsg
    label: Target EPSG
    doc: Target EPSG code used for crop reprojection
    type: string
    inputBinding:
      prefix: --epsg
  - id: band
    label: Band name
    doc: Band identifier to crop
    type: string
    inputBinding:
      prefix: --band
  - id: asset_signing
    label: Asset signing mode
    doc: Internal cloud asset signing mode (auto, none, mspc)
    default: auto
    type:
      name: _:f169ae19-2602-4158-a2db-f57ccdfa8dc9
      symbols:
      - file:///data/work/github-com/eoap/zarr-cloud-native-format/cwl-workflow/app-water-bodies.cwl#crop/asset_signing/auto
      - file:///data/work/github-com/eoap/zarr-cloud-native-format/cwl-workflow/app-water-bodies.cwl#crop/asset_signing/none
      - file:///data/work/github-com/eoap/zarr-cloud-native-format/cwl-workflow/app-water-bodies.cwl#crop/asset_signing/mspc
      type: enum
    inputBinding:
      prefix: --asset-signing
  outputs:
  - id: cropped
    label: Cropped raster
    doc: Cropped raster output for one band
    type: File
    outputBinding:
      glob: '*.tif'
  requirements:
  - class: InlineJavascriptRequirement
  - class: EnvVarRequirement
    envDef:
    - envName: PATH
      envValue: /app/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    - envName: PYTHONPATH
      envValue: /app
  - class: ResourceRequirement
    coresMax: 1
    ramMin: 2048
    ramMax: 2048
  - class: DockerRequirement
    dockerPull: crop:latest
  cwlVersion: v1.2
  baseCommand:
  - crop
  arguments: []
- https://schema.org/name: Stage-out STAC results
  https://schema.org/description: Upload the results catalog and its assets to S3-compatible
    storage.
  https://schema.org/dateCreated: '2022-09-01'
  https://schema.org/license:
    s:name: Creative Commons Attribution-ShareAlike 4.0 International
    s:url: https://creativecommons.org/licenses/by-sa/4.0/
    s:identifier: CC-BY-SA-4.0
  https://schema.org/softwareHelp:
    s:name: Mastering Earth Observation Application Packaging with CWL
    s:url: https://eoap.github.io/mastering-app-package
  https://schema.org/publisher:
    s:name: EO Application Packaging
    s:identifier: https://github.com/eoap
  https://schema.org/author:
  - s:givenName: Jane
    s:familyName: Doe
    s:email: jane.doe@acme.earth
    s:affiliation:
      s:name: ACME
  - s:givenName: John
    s:familyName: Doe
    s:email: john.doe@acme.earth
    s:affiliation:
      s:name: ACME
  https://schema.org/softwareRequirements:
  - container runtime
  - cwl runner
  https://schema.org/softwareVersion: 2.0.0
  id: stage-out
  class: CommandLineTool
  doc: Stage-out the results to S3
  inputs:
  - id: s3_bucket
    label: S3 bucket
    doc: Name of the destination S3 bucket.
    type: string
  - id: sub_path
    label: Object prefix
    doc: Object key prefix under which results are uploaded.
    type: string
  - id: aws_access_key_id
    label: S3 access key ID
    doc: Access key ID used to authenticate to the S3-compatible service.
    type: string
  - id: aws_secret_access_key
    label: S3 secret access key
    doc: Secret access key used to authenticate to the S3-compatible service.
    type: string
  - id: region_name
    label: S3 region
    doc: Region name used for S3 requests.
    type: string
  - id: endpoint_url
    label: S3 endpoint
    doc: URL of the S3-compatible service endpoint.
    type: string
  - id: stac_catalog
    label: Results STAC catalog
    doc: Directory containing the results STAC catalog and its referenced raster assets.
    type: Directory
  outputs:
  - id: s3_catalog_output
    label: Uploaded STAC catalog
    doc: S3 URI of the uploaded results catalog.
    type: https://raw.githubusercontent.com/eoap/schemas/main/string_format.yaml#URI
    outputBinding:
      outputEval: '${ return {value: "s3://" + inputs.s3_bucket + "/" + inputs.sub_path
        + "/catalog.json"}; }'
  requirements:
  - class: DockerRequirement
    dockerPull: ghcr.io/eoap/mastering-app-package/stage-out:2.0.0@sha256:2974b42df1722ebf4d220c041e4345a94553b1bb81188b545fd58c70e93f490a
  - class: InlineJavascriptRequirement
  - class: NetworkAccess
    networkAccess: true
  - class: EnvVarRequirement
    envDef:
    - envName: aws_access_key_id
      envValue: $( inputs.aws_access_key_id )
    - envName: aws_secret_access_key
      envValue: $( inputs.aws_secret_access_key )
    - envName: aws_region_name
      envValue: $( inputs.region_name )
    - envName: aws_endpoint_url
      envValue: $( inputs.endpoint_url )
    - envName: PATH
      envValue: /app/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  - class: ResourceRequirement
  - class: SchemaDefRequirement
    types:
    - name: https://raw.githubusercontent.com/eoap/schemas/main/string_format.yaml#URI
      fields:
      - name: https://raw.githubusercontent.com/eoap/schemas/main/string_format.yaml#URI/value
        doc: S3 URI of the staged catalog.
        type: string
      type: record
      doc: Published resource URI.
  cwlVersion: v1.2
  baseCommand: stage-out
  arguments:
  - $( inputs.stac_catalog.path )
  - $( inputs.s3_bucket )
  - $( inputs.sub_path )
