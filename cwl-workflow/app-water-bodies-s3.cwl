        type: https://raw.githubusercontent.com/eoap/schemas/main/experimental/api-endpoint.yaml#APIEndpoint
      - name: https://raw.githubusercontent.com/eoap/schemas/main/experimental/discovery.yaml#STACAPI/search_request
        type: https://raw.githubusercontent.com/eoap/schemas/main/experimental/discovery.yaml#STACSearchSettings
      type: record
  cwlVersion: v1.2
  baseCommand:
  - stac-client
  arguments:
  - search
  - $(inputs.api_endpoint.url.value)
  - ${ var collections = inputs.search_request.collections; return ['--collections',
    collections.join(",")]; }
  - '${ var bbox = inputs.search_request.bbox; return Array.isArray(bbox) && bbox.length
    >= 4 ? [''--bbox''].concat(bbox.map(String)) : []; }'
  - '${ var limit = inputs.search_request.limit; return [''--limit'', String(limit
    == null ? 10 : limit)]; }'
  - '${ var maxItems = inputs.search_request[''max-items'']; return [''--max-items'',
    String(maxItems == null ? 20 : maxItems)]; }'
  - ${ var args = []; var filter = inputs.search_request.filter; var filterLang =
    inputs.search_request['filter-lang']; if (filterLang) { args.push('--filter-lang',
    filterLang); } if (filter) { args.push('--filter', JSON.stringify(filter)); }
    return args; }
  - ${ var datetime = inputs.search_request.datetime; var interval = inputs.search_request.datetime_interval;
    if (datetime) { return ['--datetime', datetime]; } if (interval) { var start =
    interval.start && interval.start.value || '..'; var end = interval.end && interval.end.value
    || '..'; return ['--datetime', start + '/' + end]; } return []; }
  - '${ var ids = inputs.search_request.ids; return Array.isArray(ids) && ids.length
    > 0 ? [''--ids''].concat(ids.map(String)) : []; }'
  - '${ var intersects = inputs.search_request.intersects; return intersects ? [''--intersects'',
    JSON.stringify(intersects)] : []; }'
  - --save
  - discovery-output.json
- id: convert-search
  class: CommandLineTool
  label: Gets the item self hrefs
  doc: Gets the item self hrefs from a STAC search result
  inputs:
  - id: search_request
    label: Search Request
    doc: Search request from the discovery step
    type: https://raw.githubusercontent.com/eoap/schemas/main/experimental/discovery.yaml#STACSearchSettings
  - id: search_results
    label: Search Results
    doc: Search results from the discovery step
    type: File
  outputs:
  - id: items
    label: Item self hrefs
    doc: Array of STAC Item self links extracted from search results
    type: Any
    outputBinding:
      loadContents: true
      glob: items.json
      outputEval: ${ return JSON.parse(self[0].contents); }
  - id: aoi
    label: AOI bbox CSV
    doc: Area of interest bbox serialized as CSV for downstream crop step
    type: string
    outputBinding:
      loadContents: true
      glob: aoi.txt
      outputEval: ${ return self[0].contents.trim(); }
  requirements:
  - class: DockerRequirement
    dockerPull: ghcr.io/eoap/zarr-cloud-native-format/yq@sha256:401655f3f4041bf3d03b05f3b24ad4b9d18cfcf908c3b44f5901383621d0688a
