cwlVersion: v1.2
$namespaces:
  s: https://schema.org/
s:softwareVersion: 2.0.0
s:name: Water bodies detection workflow
s:description: Water bodies detection based on NDWI and Otsu threshold applied to
  Sentinel-2 COG STAC items
s:dateCreated: '2026-03-19'
s:license: https://spdx.org/licenses/MIT.html
s:softwareHelp:
  class: s:CreativeWork
  s:name: Zarr Cloud-Native Format documentation
  s:url: https://eoap.github.io/zarr-cloud-native-format/
s:publisher:
  class: s:Organization
  s:name: EOAP
s:author:
- class: s:Person
  s:givenName: Fabrice
  s:familyName: Brito
  s:email: info@terradue.com
  s:affiliation:
    class: s:Organization
    s:name: Terradue
s:codeRepository:
  URL: https://github.com/eoap/zarr-cloud-native-format.git
schemas:
- http://schema.org/version/9.0/schemaorg-current-http.rdf
$graph:
- id: main
  class: Workflow
  label: Workflow water-bodies orchestrator
  doc: This Workflow is used to orchestrate the Workflow water-bodies
  inputs:
  - id: stac_api_endpoint
    label: STAC API endpoint - water-bodies/stac_api_endpoint
    doc: STAC API endpoint - This parameter is derived from water-bodies/stac_api_endpoint
    default:
      headers: []
      url: https://planetarycomputer.microsoft.com/api/stac/v1
    type: Any
  - id: collection
    label: STAC collection - water-bodies/collection
    doc: STAC collection identifier - This parameter is derived from water-bodies/collection
    default: sentinel-2-l2a
    type: string
  - id: aoi
    label: Area of interest - water-bodies/aoi
    doc: Area of interest polygon with bbox [minx, miny, maxx, maxy] - This parameter
      is derived from water-bodies/aoi
    type: https://raw.githubusercontent.com/eoap/schemas/main/geojson.yaml#Polygon
  - id: start-datetime
    label: Start time - water-bodies/start-datetime
    doc: Start time - This parameter is derived from water-bodies/start-datetime
    type:
    - 'null'
    - https://raw.githubusercontent.com/eoap/schemas/main/string_format.yaml#DateTime
  - id: end-datetime
    label: End time - water-bodies/end-datetime
    doc: End time - This parameter is derived from water-bodies/end-datetime
    type:
    - 'null'
    - https://raw.githubusercontent.com/eoap/schemas/main/string_format.yaml#DateTime
  - id: limit
    label: limit - water-bodies/limit
    doc: limit - This parameter is derived from water-bodies/limit
    default: 20
    type: int
  - id: max-items
    label: max-items - water-bodies/max-items
    doc: max-items - This parameter is derived from water-bodies/max-items
    default: 10
    type: int
  - id: filter-lang
    label: Filter language - water-bodies/filter-lang
    doc: Filter language - This parameter is derived from water-bodies/filter-lang
    type:
    - 'null'
    - name: _:8992b0c1-26a1-433e-ac31-5a5af486fc21
      symbols:
      - file:///data/work/github-com/eoap/zarr-cloud-native-format/cwl-workflow/app-water-bodies.cwl#water-bodies/filter-lang/cql2-json
      type: enum
  - id: filter
    label: Filter - water-bodies/filter
    doc: Filter - This parameter is derived from water-bodies/filter
    type:
    - 'null'
    - Any
  - id: bands
    label: bands used for the NDWI - water-bodies/bands
    doc: bands used for the NDWI - This parameter is derived from water-bodies/bands
    default:
    - green
    - nir
    type:
      name: _:a4911c43-bfb6-430f-897b-b690ff639fe2
      items: string
      type: array
  - id: overview_levels
    label: Number of Zarr overview levels - water-bodies/overview_levels
    doc: Number of multiscale overview levels generated by stac-zarr - This parameter
      is derived from water-bodies/overview_levels
    default: 2
    type: int
  - id: continuous_overview_reducer
    label: Overview reducer for continuous variables - water-bodies/continuous_overview_reducer
    doc: Reducer used for continuous variables when generating overviews (mean, max,
      median, nearest) - This parameter is derived from water-bodies/continuous_overview_reducer
    default: mean
    type:
      name: _:4099bac2-403f-43a2-9e1c-d1f90fe866b4
      symbols:
      - file:///data/work/github-com/eoap/zarr-cloud-native-format/cwl-workflow/app-water-bodies.cwl#water-bodies/continuous_overview_reducer/mean
      - file:///data/work/github-com/eoap/zarr-cloud-native-format/cwl-workflow/app-water-bodies.cwl#water-bodies/continuous_overview_reducer/max
      - file:///data/work/github-com/eoap/zarr-cloud-native-format/cwl-workflow/app-water-bodies.cwl#water-bodies/continuous_overview_reducer/median
      - file:///data/work/github-com/eoap/zarr-cloud-native-format/cwl-workflow/app-water-bodies.cwl#water-bodies/continuous_overview_reducer/nearest
      type: enum
  - id: categorical_overview_reducer
    label: Overview reducer for categorical variables - water-bodies/categorical_overview_reducer
    doc: Reducer used for categorical variables when generating overviews (mean, max,
      median, nearest) - This parameter is derived from water-bodies/categorical_overview_reducer
    default: nearest
    type:
      name: _:fa33568c-f8b6-4986-a142-c70b10acf2b2
      symbols:
      - file:///data/work/github-com/eoap/zarr-cloud-native-format/cwl-workflow/app-water-bodies.cwl#water-bodies/categorical_overview_reducer/mean
      - file:///data/work/github-com/eoap/zarr-cloud-native-format/cwl-workflow/app-water-bodies.cwl#water-bodies/categorical_overview_reducer/max
      - file:///data/work/github-com/eoap/zarr-cloud-native-format/cwl-workflow/app-water-bodies.cwl#water-bodies/categorical_overview_reducer/median
      - file:///data/work/github-com/eoap/zarr-cloud-native-format/cwl-workflow/app-water-bodies.cwl#water-bodies/categorical_overview_reducer/nearest
      type: enum
  - id: stac_object_type
    label: STAC object type - water-bodies/stac_object_type
    doc: Output STAC object type emitted by stac-zarr (collection or item) - This
      parameter is derived from water-bodies/stac_object_type
    default: item
    type:
      name: _:40c14b07-2ed6-4681-a589-64639e623ff6
      symbols:
      - file:///data/work/github-com/eoap/zarr-cloud-native-format/cwl-workflow/app-water-bodies.cwl#water-bodies/stac_object_type/collection
      - file:///data/work/github-com/eoap/zarr-cloud-native-format/cwl-workflow/app-water-bodies.cwl#water-bodies/stac_object_type/item
      type: enum
  - id: s3_bucket
    label: S3 bucket - stage-out/s3_bucket
    doc: Name of the destination S3 bucket. - This parameter is derived from stage-out/s3_bucket
    type: string
  - id: sub_path
    label: Object prefix - stage-out/sub_path
    doc: Object key prefix under which results are uploaded. - This parameter is derived
      from stage-out/sub_path
    type: string
  - id: aws_access_key_id
    label: S3 access key ID - stage-out/aws_access_key_id
    doc: Access key ID used to authenticate to the S3-compatible service. - This parameter
      is derived from stage-out/aws_access_key_id
    type: string
  - id: aws_secret_access_key
    label: S3 secret access key - stage-out/aws_secret_access_key
    doc: Secret access key used to authenticate to the S3-compatible service. - This
      parameter is derived from stage-out/aws_secret_access_key
    type: string
  - id: region_name
    label: S3 region - stage-out/region_name
    doc: Region name used for S3 requests. - This parameter is derived from stage-out/region_name
    type: string
  - id: endpoint_url
    label: S3 endpoint - stage-out/endpoint_url
    doc: URL of the S3-compatible service endpoint. - This parameter is derived from
      stage-out/endpoint_url
    type: string
  outputs:
  - id: zarr_stac_catalog
    label: Zarr STAC catalog
    doc: STAC catalog produced by the stac-zarr step
    outputSource: stage_out_0/s3_catalog_output
    type: https://raw.githubusercontent.com/eoap/schemas/main/string_format.yaml#URI
